# ---------------------------------------------------------------------------
# Ecomly environment template.
# Copy to `.env.local` and fill in real values. Never commit `.env` / `.env.local`.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Mongo connection string used by lib/database/db.ts
MONGODB_URI=

# Secret used by NextAuth to sign sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Public origin of this deployment, e.g. https://app.example.com
# Used to land users after the eBay OAuth callback.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Encryption -------------------------------------------------------------
# Key used to encrypt integration credentials at rest (AES-256-GCM via lib/crypto.ts).
# Generate a fresh value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If left unset the app falls back to AUTH_SECRET, which is not ideal - set it explicitly.
# Rotating this value makes existing stored credentials undecryptable.
ENCRYPTION_KEY=

# --- eBay OAuth 2.0 ---------------------------------------------------------
# App ID (Client ID) from the eBay Developer Portal.
EBAY_CLIENT_ID=

# Client Secret for the eBay app. Used for the Basic-auth code-for-token exchange.
# Server-side only - never expose this to the browser.
EBAY_CLIENT_SECRET=

# The eBay Redirect URL name (RuName) registered on the app. This is not a URL.
EBAY_RUNAME=
# `EBAY_RU_NAME` is also accepted for compatibility with eBay examples.

# SANDBOX or PRODUCTION. This switches the authorization URL, token URL, and
# API host together. Use sandbox keys (the client ID contains `SBX`), the
# sandbox RuName, and a sandbox test user when set to SANDBOX.
EBAY_ENV=SANDBOX

# --- Google OAuth (sign-in) -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Third-party services ---------------------------------------------------
GROQ_API_KEY=

GMAIL_USER=
GMAIL_APP_PASSWORD=
